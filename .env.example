# Copy to .env (gitignored) and fill in. Values already set in the shell win over this file.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# An OpenRouter model id. Phase 0c must use a non-Claude model.
OPENAI_MODEL=
OPENAI_API_KEY=
# Required for any non-localhost endpoint. Phase 0 data is public (OTRF).
ALLOW_CLOUD=true
# Set to false if the endpoint rejects a JSON-schema response_format. Replies are still parsed strictly.
STRUCTURED_OUTPUT=true

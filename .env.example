# Copy to .env (gitignored) and fill in. Values already set in the shell win over this file.
# One block per provider; pick one per run with: python -m eval.harness run --provider groq
# The model must not be Claude (the labels were Claude-proposed).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_API_KEY=

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
GROQ_API_KEY=
# Optional per provider: GROQ_ALLOW_CLOUD, GROQ_STRUCTURED_OUTPUT override the shared values below.

# Without --provider, the harness reads OPENAI_BASE_URL, OPENAI_MODEL, OPENAI_API_KEY instead
# (scripts/null_test/run.py reads only these).

# Required for any non-localhost endpoint. Phase 0 data is public (OTRF).
ALLOW_CLOUD=true
# Set to false if the endpoint rejects a JSON-schema response_format. Replies are still parsed strictly.
STRUCTURED_OUTPUT=true
